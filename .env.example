PORT=3001
NODE_ENV=development
AZURE_CLIENT_ID=<azure-app-client-id>
AZURE_TENANT_ID=<azure-tenant-id>
JWT_SECRET=<random-secret-for-session-jwt>
VOTE_TOKEN_SECRET=<random-secret-for-vote-token-hashing-and-encryption>
DATABASE_URL=postgresql://tee_admin:tee_local_password@localhost:5432/tee_voting
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
# En Vercel debe ser >=1 para resolver la IP real tras el proxy (evita ERR_ERL_UNEXPECTED_X_FORWARDED_FOR).
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
# Limite general por SESION (token) para autenticados; por IP para anonimos.
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=20

# --- Observabilidad (OpenTelemetry) — OPCIONAL ---
# La telemetria SOLO se activa si OTEL_EXPORTER_OTLP_ENDPOINT esta definida.
# Sin estas variables el backend funciona igual que siempre (cero overhead).
# Ejemplo para Grafana Cloud (OTLP):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <token-base64-de-grafana-cloud>
# OTEL_SERVICE_NAME=tee-voting-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
# OTEL_METRIC_EXPORT_INTERVAL=15000
# OBSERVABILITY_ENABLED=true   # ponlo en 'false' para desactivar aun con endpoint definido
